          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "appId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
