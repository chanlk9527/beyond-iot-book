{
  "openapi": "3.0.3",
  "info": {
    "title": "星云 IoT OpenAPI 与开发者管理接口",
    "version": "0.1.0",
    "description": "2026-10-19 按当前代码核对。外部 JSON 令牌协议不是完整 OAuth 2.0；不提供用户委托、设备资源授权或业务设备 API。管理接口使用独立 Session/CSRF。"
  },
  "servers": [
    {
      "url": "/",
      "description": "同源部署地址；生产使用 HTTPS，本地联调用 HTTP。"
    }
  ],
  "tags": [
    {
      "name": "应用认证"
    },
    {
      "name": "租户开发者"
    },
    {
      "name": "平台审核"
    },
    {
      "name": "历史平台应用"
    },
    {
      "name": "管理登录"
    }
  ],
  "paths": {
    "/api/open/v1/oauth/token": {
      "post": {
        "tags": [
          "应用认证"
        ],
        "operationId": "issueAccessToken",
        "summary": "换取应用令牌",
        "description": "JSON 自定义协议。省略 subject、tenantId。应用必须启用且已获批；申请范围不能超过已获批范围。",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "禁止缓存敏感响应",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        }
      }
    },
    "/api/open/v1/me": {
      "get": {
        "tags": [
          "应用认证"
        ],
        "operationId": "getOpenApiPrincipal",
        "summary": "查询当前应用身份",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Principal"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "禁止缓存敏感响应",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/open/v1/oauth/revoke": {
      "post": {
        "tags": [
          "应用认证"
        ],
        "operationId": "revokeAccessToken",
        "summary": "撤销当前请求的令牌",
        "description": "撤销后再次使用（包括重复撤销）返回401。",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "成功",
            "headers": {
              "Cache-Control": {
                "description": "禁止缓存敏感响应",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/management/developer/tenants/{tenantId}/apps": {
      "get": {
        "tags": [
          "租户开发者"
        ],
        "operationId": "listTenantApplications",
        "summary": "列出本租户最近100个应用",
        "description": "要求本租户有效 OWNER/ADMIN；平台超管身份不自动授予成员资格。",
        "security": [
          {
            "ManagementSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "$ref": "#/components/schemas/DeveloperApp"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "租户开发者"
        ],
        "operationId": "createTenantApplication",
        "summary": "创建并提交应用申请",
        "description": "平台生成 appId；初始 PENDING 且停用，不返回密钥。",
        "security": [
          {
            "ManagementSession": [],
            "CsrfToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeveloperApp"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplication"
              }
            }
          }
        }
      }
