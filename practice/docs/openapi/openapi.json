          }
        },
        "parameters": [
          {
            "name": "appId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Revision"
              }
            }
          }
        }
      }
    },
    "/api/management/auth/csrf": {
      "get": {
        "tags": [
          "管理登录"
        ],
        "operationId": "getManagementCsrf",
        "summary": "获取管理请求CSRF",
        "description": "保留服务端 Session Cookie；登录成功后重新获取。",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/management/auth/login": {
      "post": {
        "tags": [
          "管理登录"
        ],
        "operationId": "loginManagement",
        "summary": "管理账号登录",
        "description": "Session+CSRF；成功后重新获取CSRF。",
        "security": [
          {
            "ManagementSession": [],
            "CsrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "成功"
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/management/auth/logout": {
      "post": {
        "tags": [
          "管理登录"
        ],
        "operationId": "logoutManagement",
        "summary": "退出管理登录",
        "description": "保留 Session Cookie 并携带 CSRF。",
        "security": [
          {
            "ManagementSession": [],
            "CsrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "成功"
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "不透明应用令牌，有效期1800秒，无 refresh token。"
      },
      "ManagementSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "管理登录 Session，不由外部 Bearer 替代。"
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "先获取 auth/csrf 并保留 Cookie；运行时以返回的 headerName 为准。"
      }
    },
    "schemas": {
      "Scope": {
        "type": "string",
        "enum": [
          "device:read",
          "device:control",
          "video:watch",
          "video:recording",
          "event:read"
        ]
      },
      "Scopes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/components/schemas/Scope"
        },
        "description": "非空能力集合，无顺序含义。"
      },
      "TokenRequest": {
        "type": "object",
        "required": [
          "appId",
          "clientSecret",
          "scopes"
        ],
        "properties": {
          "appId": {
            "type": "string"
          },
          "clientSecret": {
            "type": "string",
            "description": "服务端应用密钥",
            "writeOnly": true
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "scopes"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "不透明令牌，不解析其内容"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "example": 1800
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "appId",
          "subject",
          "tenantId",
          "scopes",
          "expiresAt"
        ],
        "properties": {
          "appId": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "当前等于 appId，未支持外部用户代调用"
          },
          "tenantId": {
            "type": "string",
            "description": "来自平台的应用归属；历史平台应用可为空",
            "nullable": true
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeveloperApp": {
        "type": "object",
        "required": [
          "appId",
          "name",
          "tenantId",
          "tenantName",
          "requestedScopes",
          "scopes",
          "reviewStatus",
          "reviewNote",
          "enabled",
          "revision"
        ],
        "properties": {
          "appId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "requestedScopes": {
            "type": "string",
            "description": "空格分隔能力字符串"
          },
          "scopes": {
            "type": "string",
            "description": "空格分隔已授予能力，无能力时为空字符串"
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "reviewNote": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          }
        }
      },
      "CreateApplication": {
        "type": "object",
        "required": [
          "name",
          "scopes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "非空应用名称",
            "minLength": 1,
            "maxLength": 100
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          }
        }
      },
      "SubmitApplication": {
        "type": "object",
        "required": [
          "revision",
          "scopes"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          }
        }
      },
      "ReviewApplication": {
        "type": "object",
        "required": [
          "revision",
          "approved",
          "scopes",
          "note"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          },
          "approved": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Scope"
            },
            "description": "批准时为申请范围的非空子集，驳回时可为空。"
          },
          "note": {
            "type": "string",
            "description": "必传；驳回时不能为空。",
            "maxLength": 1000
          }
        }
      },
      "ApplicationStatus": {
        "type": "object",
        "required": [
          "revision",
          "enabled"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Revision": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          }
        }
      },
      "Secret": {
        "type": "object",
        "required": [
          "clientSecret"
        ],
        "properties": {
          "clientSecret": {
            "type": "string",
            "description": "仅在本次轮换成功时返回，无法查询原值。"
          }
        }
      },
      "AppAudit": {
        "type": "object",
        "required": [
          "actor",
          "action",
          "detail",
          "occurredAt"
        ],
        "properties": {
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATED",
              "SUBMITTED",
              "APPROVED",
              "REJECTED",
              "SECRET_ROTATED",
              "ENABLED",
              "DISABLED"
            ]
          },
          "detail": {
            "type": "string",
            "description": "仅供展示，不作为结构化业务字段"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlatformApplication": {
        "type": "object",
        "required": [
          "appId",
          "name",
          "scopes",
          "enabled",
          "revision"
        ],
        "properties": {
          "appId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "读取最近一次列表结果，不自行推算。"
          }
        }
      },
      "LegacyRegister": {
        "type": "object",
        "required": [
          "appId",
          "name",
          "scopes"
        ],
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "scopes": {
            "$ref": "#/components/schemas/Scopes"
          }
        }
      },
      "Registration": {
        "type": "object",
        "required": [
          "application",
          "clientSecret"
        ],
        "properties": {
          "application": {
            "$ref": "#/components/schemas/PlatformApplication"
          },
          "clientSecret": {
            "type": "string",
            "description": "仅本次创建返回"
          }
        }
      },
      "Csrf": {
        "type": "object",
        "required": [
          "headerName",
          "token"
        ],
        "properties": {
          "headerName": {
            "type": "string",
            "example": "X-CSRF-TOKEN"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_client_or_token",
              "insufficient_permission",
              "application_already_exists"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "按 HTTP 状态处理；错误体可能为自定义 error 或 Problem Detail，不依赖 detail 文案。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
