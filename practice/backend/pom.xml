<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.nebula.iot</groupId>
    <artifactId>nebula-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Nebula IoT Platform</name>
    <description>Parent and reactor for the modular IoT platform</description>
    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.54.1</aws-sdk.version>
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
        <vertx.version>5.1.10</vertx.version>
        <!-- 与Vert.x依赖清单对齐，避免混用Boot默认的Netty版本。 -->
        <netty.version>4.2.19.Final</netty.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>software.amazon.awssdk</groupId><artifactId>bom</artifactId><version>${aws-sdk.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>media-component</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>video-manager</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>device-manager</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>${mybatis-spring-boot.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>identity-manager</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>tenant-manager</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.vertx</groupId><artifactId>vertx-dependencies</artifactId><version>${vertx.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>gateway-component</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>protocol-component</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>network-component</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nebula.iot</groupId><artifactId>message-component</artifactId><version>${project.version}</version></dependency>
            <dependency>
                <groupId>com.nebula.iot</groupId>
                <artifactId>platform-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <modules>
        <module>platform-core</module>
        <module>platform-components</module>
        <module>platform-manager</module>
        <module>module-template</module>
        <module>platform-bootstrap</module>
    </modules>
</project>
