# Copy this file to .env.local. This file is not loaded automatically by Spring Boot.
# Start with ../manage.sh (macOS) or scripts/Start-Management.ps1 (Windows).
DATABASE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=require&connectTimeout=10
# For MySQL 8.4 use: jdbc:mysql://YOUR_DATABASE_HOST:3306/nebula?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=__FILL_DATABASE_PASSWORD__

# Optional Redis. Upstash provides a rediss:// URL; a self-hosted Redis URL can
# replace it later without changing application code. Redis is disabled by default.
# REDIS_ENABLED=true
# REDIS_URL=rediss://default:__FILL_UPSTASH_PASSWORD__@__UPSTASH_HOST__:6379
# REDIS_COMMAND_TIMEOUT_MS=2000

# Optional history storage. Policies remain separate from the thing model.
HISTORY_PROVIDER=disabled
# HISTORY_PROVIDER=tdengine
# HISTORY_MAXIMUM_RETENTION_DAYS=3650
# TDENGINE_URL=jdbc:TAOS-WS://127.0.0.1:6041/
# TDENGINE_USERNAME=root
# TDENGINE_PASSWORD=__FILL_TDENGINE_PASSWORD__
# TDENGINE_DATABASE=nebula_history

# Optional: explicitly create the first platform administrator (separate from the database account).
# Supply username, password AND PLATFORM_ADMIN=true when creating the first account; no default credentials.
# NEBULA_MANAGEMENT_INITIAL_ACCOUNT_USERNAME=your-login-name
# NEBULA_MANAGEMENT_INITIAL_ACCOUNT_PASSWORD=__FILL_INITIAL_ACCOUNT_PASSWORD__

# Explicit platform privilege grant to the initial account; remove after successful initialization.
# NEBULA_MANAGEMENT_INITIAL_ACCOUNT_PLATFORM_ADMIN=true

# MQTT 5 is enabled by default on 127.0.0.1:1883; optional overrides.
# MQTT_ENABLED=true
# MQTT_PORT=1883

# C-end live access is disabled by default. Enable only behind the trusted App Server.
# NEBULA_APP_VIDEO_ENABLED=false
# NEBULA_APP_VIDEO_SIGNING_SECRET=__SET_OUT_OF_BAND__
# NEBULA_APP_VIDEO_SIGNATURE_SKEW=PT60S

# EventBus: local or kafka. Kafka requires a unique node id and pre-created topics.
EVENTBUS_MODE=local
EVENTBUS_NODE_ID=
EVENTBUS_NAMESPACE=nebula
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTBUS_TOPIC=iot.platform.events.v1
EVENTBUS_FAILURE_TOPIC=iot.platform.events.failed.v1
